{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime.version": "Lua 5.1",
  "runtime.nonstandardSymbol": [
    "!=",
    "continue",
    "//"
  ],
  "workspace.ignoreDir": [
    "Libs",
    ".libraries",
    ".git",
    ".vscode",
    ".claude"
  ],
  "diagnostics.workspaceDelay": 3000,
  "diagnostics.disable": [
    "lowercase-global",
    "duplicate-set-field",
    "missing-fields",
    "inject-field",
    "cast-local-type",
    "param-type-mismatch",
    "return-type-mismatch"
  ],
  "diagnostics.globals": [
    "BattleGroundEnemies",
    "LibStub",
    "hooksecurefunc",
    "issecretvalue",
    "Ambiguate",
    "Mixin",
    "CopyTable",
    "MergeTable",
    "tAppendAll",
    "tContains",
    "CreateFromMixins",
    "CreateFrame",
    "CreateObjectPool",
    "BackdropTemplateMixin",
