# Editor-level consistency across macOS/Windows (pairs with .gitattributes for
# git-level normalization and stylua.toml for Lua style).
root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
